generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Authentication & Roles
enum Role {
  Admin
  Cashier
  Waiter
  KitchenStaff
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(Cashier)
  salary    Decimal? @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  sessions  Session[]
  orders    Order[]   @relation("OrderWaiter")
  cart      Cart[]
}

model Otp {
  id        Int      @id @default(autoincrement())
  email     String
  otp       String 
  status    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 2. Menu Management
model FoodCategory {
  id        Int      @id @default(autoincrement())
  name      String
  image     String?
  status    Boolean  @default(true) // Available/Unavailable
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  foods     Food[]
  
  @@map("foodcategory")
}

model Food {
  id                Int          @id @default(autoincrement())
  name              String
  description       String?
  price             Decimal      @db.Decimal(10, 2)
  discountPercentage Decimal     @default(0) @db.Decimal(5, 2) // Item-specific discount
  image             String?
  categoryId        Int
  status            Boolean      @default(true) // Available/Out of Stock
  ingredients       String?      // Simple string list for now, or JSON
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  
  // Relations
  category          FoodCategory @relation(fields: [categoryId], references: [id])
  orderItems        OrderItem[]
  cart              Cart[]
  
  @@map("Food")
}

// 3. Order Management
enum OrderStatus {
  New
  InProgress
  Ready
  Served
  Paid
  Cancelled
}

enum OrderType {
  DineIn
  Takeaway
}

model Order {
  id            Int         @id @default(autoincrement())
  orderNumber   String      @unique @default(uuid()) // Or a generated daily sequence
  type          OrderType
  status        OrderStatus @default(New)
  
  // Dine-in fields
  tableNumber   String?
  
  // Takeaway fields
  customerName  String?
  customerPhone String?
  
  // Financials
  totalAmount   Decimal     @default(0) @db.Decimal(10, 2)
  
  // Tracking
  waiterId      Int?        // Who took the order
  sessionId     Int?        // Which POS session
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  // Relations
  waiter        User?       @relation("OrderWaiter", fields: [waiterId], references: [id])
  session       Session?    @relation(fields: [sessionId], references: [id])
  items         OrderItem[]
  bill          Bill?
  customer      Customer?   @relation(fields: [customerId], references: [id])
  customerId    Int?
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  foodId      Int
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  subtotal    Decimal  @db.Decimal(10, 2)
  notes       String?  // Special instructions
  
  // Relations
  order       Order    @relation(fields: [orderId], references: [id])
  food        Food     @relation(fields: [foodId], references: [id])
}

// 4. Billing & Checkout
enum PaymentMethod {
  Cash
  Card
  Mobile
  Split
}

model Bill {
  id            Int           @id @default(autoincrement())
  orderId       Int           @unique
  invoiceNumber String        @unique
  
  subtotal      Decimal       @db.Decimal(10, 2)
  tax           Decimal       @default(0) @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  grandTotal    Decimal       @db.Decimal(10, 2)
  
  paymentMethod PaymentMethod?
  isPaid        Boolean       @default(false)
  
  createdAt     DateTime      @default(now())
  
  // Relations
  order         Order         @relation(fields: [orderId], references: [id])
  transactions  Transaction[]
}

model Transaction {
  id        Int           @id @default(autoincrement())
  billId    Int
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod
  reference String?       // Trans ID for cards etc.
  createdAt DateTime      @default(now())
  
  bill      Bill          @relation(fields: [billId], references: [id])
}

// 5. Inventory / Stock Management
model StockItem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  quantity  Decimal  @default(0) @db.Decimal(10, 3)
  unit      String   // kg, pcs, liters
  threshold Decimal  @default(5) @db.Decimal(10, 3) // Low stock alert level
  updatedAt DateTime @updatedAt
}

// 7. Customer Management
model Customer {
  id          Int      @id @default(autoincrement())
  name        String
  phone       String   @unique
  totalVisits Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  orders      Order[]
}

// 9. Session & Terminal Management
model Session {
  id          Int      @id @default(autoincrement())
  userId      Int      // Opened by
  terminalId  String?  
  
  openedAt    DateTime @default(now())
  closedAt    DateTime?
  
  openingCash Decimal  @db.Decimal(10, 2)
  closingCash Decimal? @db.Decimal(10, 2)
  
  totalSales  Decimal  @default(0) @db.Decimal(10, 2)
  status      String   @default("OPEN") // OPEN, CLOSED
  
  // Relations
  user        User     @relation(fields: [userId], references: [id])
  orders      Order[]
}

// Table Management
model DiningTable {
  id        Int      @id @default(autoincrement())
  number    String   @unique
  capacity  Int      @default(4)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  bookings  Booking[]
}

model Booking {
  id           Int         @id @default(autoincrement())
  customerName String
  phone        String
  guests       Int
  bookingTime  DateTime
  tableId      Int
  table        DiningTable @relation(fields: [tableId], references: [id])
  status       String      @default("Reserved") // Reserved, Seated, Cancelled, Completed
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

// Settings
model Setting {
  id        Int     @id @default(autoincrement())
  key       String  @unique // e.g., 'tax_rate', 'store_name'
  value     String
}

enum Status {
  Pending
  Cancelled
  Success
}

model Cart {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  foodId     Int
  food       Food     @relation(fields: [foodId], references: [id])
  quantity   Int
  totalPrice Float
  status     Status   @default(Pending)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("cart")
}

model Supplier {
  id                  Int      @id @default(autoincrement())
  name                String
  phone               String
  email               String?
  address             String?
  itemType            String
  status              String   @default("Active")
  purchaseDate        DateTime?
  totalPurchaseAmount Decimal?  @db.Decimal(10, 2)
  paymentStatus       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("suppliers")
}
